  "plannedElements": [
    {
      "tone": "physical",
      "promptBasis": "Warm white and amber pixel slash, compact square spark particles, RO-like melee impact, no scenery or text."
    },
    {
      "tone": "fire",
      "promptBasis": "Orange-red pixel burst with ember squares and bright white core, RO-like fire skill impact, no smoke cloud that hides targets."
    },
    {
      "tone": "ice",
      "promptBasis": "Blue-white pixel shard crescent with small crystal squares, clean icy hit effect, readable over green fields."
    },
    {
      "tone": "shadow",
      "promptBasis": "Purple-black pixel crescent with violet sparks and thin dark aura, restrained so it does not obscure HP bars."
    },
    {
      "tone": "holy",
      "promptBasis": "Gold-white pixel starburst with small cross-like spark clusters, bright but compact healing or holy hit effect."
    },
    {
      "tone": "storm",
      "promptBasis": "Blue-white wind or lightning arc with sharp pixel streaks, short crescent shape for skill hits."
    },
    {
      "tone": "support",
      "promptBasis": "Soft green-gold pixel glow with tiny square motes, used for healing and buffs without attack-like aggression."
    },
    {
      "tone": "burn",
      "promptBasis": "Small orange-red pixel flame ring with ember motes, readable as a lingering burn without covering the monster."
    },
    {
      "tone": "freeze",
      "promptBasis": "Compact blue-white crystal cluster and frost ring, clear frozen status residue with crisp pixel shards."
    },
    {
      "tone": "poison",
      "promptBasis": "Green-violet pixel mist with small bubbles, compact poison residue that stays behind the enemy silhouette."
    },
    {
      "tone": "snare",
      "promptBasis": "Brown-green root binding ring with small leaves and thorns, used as a ground-level restraint status."
    },
    {
      "tone": "mark",
      "promptBasis": "Gold-red target rune glow, compact marked-target residue for follow-up skills."
    },
    {
      "tone": "break",
      "promptBasis": "Cracked shield fragments and small stone chips, readable armor-break status with restrained motion."
    },
    {
      "tone": "wound",
      "promptBasis": "Red pixel slash droplets over a small circular trace, readable wound status without gore."
    },
    {
      "tone": "death",
      "promptBasis": "Warm white and amber pixel dust pop with small square motes, compact monster defeat feedback."
    },
    {
      "tone": "boss-death",
      "promptBasis": "Larger golden pixel burst with faint purple edge and star motes, reserved for boss defeat."
    },
    {
      "tone": "loot",
      "promptBasis": "Treasure chest pixel sparkle with gem glints and warm reward motes, used beside high-value drops."
    },
    {
      "tone": "gold",
      "promptBasis": "Small gold coin pixel sparkle with square motes, subtle per-kill reward accent."
    },
    {
      "tone": "player-heal",
      "promptBasis": "Soft green-gold pixel healing ring with warm white core and square motes, used for player recovery feedback."
    },
    {
      "tone": "player-shield",
      "promptBasis": "Blue-gold compact pixel barrier crest with bright guard sparks, used for player block and shield feedback."
    },
    {
      "tone": "player-dodge",
      "promptBasis": "Pale blue-white pixel afterimage swirl with short wind streaks, used for miss and dodge feedback near the player."
    },
    {
      "tone": "player-hurt",
      "promptBasis": "Compact red-orange pixel impact burst with amber square sparks, used for incoming player hit feedback without gore."
    },
    {
      "tone": "enemy-warning",
      "promptBasis": "Compact orange-red pixel claw warning flare with ember squares and a faint triangular anticipation arc for normal monster windups."
    },
    {
      "tone": "boss-cast",
      "promptBasis": "Dark red and gold pixel magic circle with rune rings and square sparks, used for Boss skill charging cues."
    },
    {
      "tone": "boss-impact",
      "promptBasis": "Red-gold pixel impact burst with crimson core and short radial streaks, reserved for Boss skill hits without gore."
    },
    {
      "tone": "danger-mark",
      "promptBasis": "Compact red warning sigil made of pixels and angular sparks, used near the player as a danger marker."
    },
    {
      "tone": "mvp-aura-early",
      "promptBasis": "Transparent PNG sprite sheet, 16 frames, pink-white and warm gold RO-like ground aura with thin ring arcs, tiny square motes, and soft alpha glow."
    },
    {
      "tone": "mvp-aura-advanced",
      "promptBasis": "Transparent PNG sprite sheet, 16 frames, red-gold and violet RO-like ground magic circle with angular rune ticks, dark inner traces, and controlled alpha glow."
    }
  ]
}
