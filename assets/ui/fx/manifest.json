{
  "style": "ro-pixel-generated-vfx",
  "rules": {
    "generatedOnly": true,
    "transparentPng": true,
    "noCssDrawnReplacement": true,
    "noGifSpriteSheets": true,
    "notes": "All image-based battle VFX should be generated as RO-inspired pixel assets, processed to transparent PNG, and then wired into the combat layer. CSS may position, size, tint, and animate generated images, but should not draw replacement slash or burst art."
  },
